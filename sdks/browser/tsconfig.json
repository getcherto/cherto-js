{
  "extends": "@cherto/config/tsconfig.node",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2024", "DOM"],
    // tsup's dts bundler (rollup-plugin-dts) reports a phantom `baseUrl`
    // (TS5101) that `tsc --showConfig` doesn't; nothing here sets `baseUrl`.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
