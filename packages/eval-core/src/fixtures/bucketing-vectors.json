    "h64": "3949900377606600029",
    "bucket": 29,
    "sortedVariantsWithCutoffs": [
      {
        "key": "a",
        "allocationPercentage": 0.03,
        "cutoff": 30
      },
      {
        "key": "b",
        "allocationPercentage": 99.97,
        "cutoff": 100000
      }
    ],
    "chosenVariant": "a",
    "note": "cutoff for 0.03% = round(0.03 * 1000) = 30. bucket 29 < 30 → variant 'a'. Wrong formula floor((0.03/100)*100000) = 29 → bucket 29 is NOT < 29 → would return 'b'. This case MUST fail on any implementation using floor instead of round."
  },
